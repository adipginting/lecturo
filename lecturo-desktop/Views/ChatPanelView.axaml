<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lecturo.ViewModels"
             xmlns:chat="using:Lecturo.Domain.Chat"
             xmlns:ctl="using:Lecturo.Controls"
             x:Class="Lecturo.Views.ChatPanelView"
             x:DataType="vm:ChatPanelViewModel">

    <DockPanel Background="{StaticResource SurfaceBrush}">

        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="14,12"
                BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                <Button Grid.Column="0" Classes="icon" ToolTip.Tip="Close chat"
                        Command="{Binding CollapseCommand}">
                    <Path Data="{StaticResource IconBack}" Width="16" Height="16" Stretch="Uniform"
                          Fill="{StaticResource OnSurfaceVariantBrush}" />
                </Button>

                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center" Spacing="2">
                    <Grid>
                        <TextBlock Classes="cardTitle" Text="{Binding ConversationTitle}"
                                   IsVisible="{Binding !IsRenaming}"
                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsRenaming}">
                            <TextBox Text="{Binding RenameText}" Width="170" />
                            <Button Classes="text" Content="Save" Command="{Binding CommitRenameCommand}" />
                            <Button Classes="text" Content="Cancel" Command="{Binding CancelRenameCommand}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Classes="metaSm" Text="{Binding ExcerptMeta}"
                               IsVisible="{Binding HasContext}"
                               MaxLines="1" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center" Margin="6,0"
                            HorizontalAlignment="Right">
                    <TextBlock Classes="contextCounter" Classes.over="{Binding IsOverContext}"
                               HorizontalAlignment="Right"
                               Text="{Binding ContextLabel}" IsVisible="{Binding HasContext}" />
                    <TextBlock Classes="accent" FontSize="12" FontWeight="Medium"
                               HorizontalAlignment="Right"
                               Text="{Binding SelectedProvider.DisplayName}" />
                </StackPanel>

                <Button Grid.Column="3" Classes="icon" ToolTip.Tip="Compact conversation"
                        IsVisible="{Binding IsConversation}"
                        Command="{Binding CompactCommand}">
                    <Path Data="{StaticResource IconMoreVert}" Width="16" Height="16" Stretch="Uniform"
                          Fill="{StaticResource OnSurfaceVariantBrush}" />
                </Button>

                <Button Grid.Column="4" Classes="icon" ToolTip.Tip="Rename chat"
                        IsVisible="{Binding IsConversation}"
                        Command="{Binding BeginRenameCommand}">
                    <Path Data="{StaticResource IconEdit}" Width="16" Height="16" Stretch="Uniform"
                          Fill="{StaticResource OnSurfaceVariantBrush}" />
                </Button>
            </Grid>
        </Border>

        <!-- Composer -->
        <Border DockPanel.Dock="Bottom" Padding="14,12" IsVisible="{Binding HasContext}"
                BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="0,1,0,0">
            <StackPanel Spacing="10">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              IsVisible="{Binding HasPrompts}">
                    <ItemsControl ItemsSource="{Binding Prompts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="chat:Prompt">
                                <Button Classes="chip" Content="{Binding Name}"
                                        Command="{Binding $parent[ItemsControl].((vm:ChatPanelViewModel)DataContext).UsePromptCommand}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid ColumnDefinitions="*,Auto">
                    <TextBox x:Name="ComposerBox" Grid.Column="0" MinHeight="60" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             PlaceholderText="Ask about this excerpt"
                             Text="{Binding Composer}" />
                    <Button Grid.Column="1" Classes="icon" Margin="6,0,0,0" VerticalAlignment="Bottom"
                            ToolTip.Tip="Send" Command="{Binding SendCommand}">
                        <Path Data="{StaticResource IconSend}" Width="20" Height="20" Stretch="Uniform"
                              Fill="{StaticResource PrimaryBrush}" />
                    </Button>
                </Grid>

                <TextBlock Classes="helper" Text="{Binding StatusMessage}"
                           IsVisible="{Binding !!StatusMessage.Length}" />
            </StackPanel>
        </Border>

        <!-- Body -->
        <Grid>
            <StackPanel Margin="24,64,24,0" Spacing="10" HorizontalAlignment="Center"
                        VerticalAlignment="Top" IsVisible="{Binding IsEmpty}">
                <Path Data="{StaticResource IconChat}" Width="36" Height="36" Stretch="Uniform"
                      Fill="{StaticResource OutlineVariantBrush}" HorizontalAlignment="Center" />
                <TextBlock Classes="sectionTitle" Text="No chat open" HorizontalAlignment="Center" />
                <TextBlock Classes="helper" TextAlignment="Center" MaxWidth="300"
                           Text="Ask about a passage while reading and it opens here as a draft. You can also open a conversation from Chats." />
            </StackPanel>

            <DockPanel IsVisible="{Binding HasContext}">
                <Border DockPanel.Dock="Top" Margin="14,14,14,6" Background="{StaticResource SecondaryContainerBrush}"
                        CornerRadius="12" Padding="14,12">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding ContextTitle}" FontSize="12" FontWeight="Medium"
                                   Foreground="{StaticResource OnSecondaryContainerBrush}" />
                        <Image Source="{Binding Image}" MaxHeight="220" Stretch="Uniform"
                               HorizontalAlignment="Left" IsVisible="{Binding HasImage}" />
                        <TextBlock Classes="excerptLg" Text="{Binding ExcerptText}"
                                   Foreground="{StaticResource OnSecondaryContainerBrush}"
                                   MaxLines="6" TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding !HasImage}" />
                        <TextBlock Classes="metaSm" Text="{Binding ExcerptMeta}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="MessagesScroll" Margin="14,6,14,14">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChatBubble">
                                <Border Classes="bubble" Classes.user="{Binding IsUser}"
                                        Classes.dim="{Binding Superseded}" Margin="0,0,0,10">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Summary" FontSize="11" FontWeight="Medium"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   IsVisible="{Binding IsSummary}" />
                                        <ctl:MarkdownPresenter Markdown="{Binding Content}"
                                                               FontFamily="{StaticResource UiFont}"
                                                               FontSize="14"
                                                               IsVisible="{Binding !HasMath}" />
                                        <ctl:MathsView MarkdownText="{Binding Content}"
                                                       TextColor="#1C1B1F" TextSize="14"
                                                       IsVisible="{Binding HasMath}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                    Spacing="4" IsVisible="{Binding IsUser}">
                                            <TextBlock Classes="metaSm" FontSize="11" Text="Sending…"
                                                       IsVisible="{Binding IsSending}" />
                                            <TextBlock Classes="metaSm" FontSize="11" Text="Not sent"
                                                       IsVisible="{Binding IsFailed}" />
                                            <StackPanel Orientation="Horizontal" Spacing="4"
                                                        IsVisible="{Binding IsDelivered}">
                                                <TextBlock Classes="metaSm" FontSize="11" LetterSpacing="-3"
                                                           Text="✓✓" />
                                                <TextBlock Classes="metaSm" FontSize="11" Text="{Binding TimeLabel}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Classes="metaSm" FontSize="11"
                                                   Text="{Binding TimeLabel}"
                                                   HorizontalAlignment="Left"
                                                   IsVisible="{Binding !IsUser}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>

</UserControl>
